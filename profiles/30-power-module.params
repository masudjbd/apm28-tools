# 3DR-style power module wired to the APM 2.8 PM port.
# BATT_MONITOR 4 = voltage and current.
# The multipliers below are the standard APM2 analog pin mapping; verify the
# reported voltage against a meter before trusting the battery failsafe.
BATT_MONITOR 4
BATT_VOLT_PIN 13
BATT_CURR_PIN 12
BATT_VOLT_MULT 10.1
BATT_AMP_PERVOLT 17.0
